# SMS Notification Configuration for Failed Form Submissions
# Add these variables to your .env.local file

# Required: Your phone number (digits only, no formatting)
OWNER_PHONE_NUMBER=your_phone_number_digits_only

# Option 1: Email-to-SMS Gateway (simpler setup)
# Choose your carrier's gateway:
# Verizon: vtext.com
# AT&T: txt.att.net  
# T-Mobile: tmomail.net
# Sprint: messaging.sprintpcs.com
SMS_CARRIER_GATEWAY=vtext.com

# Required for email-to-SMS: Your email service
FROM_EMAIL=noreply@yourdomain.com

# Option 2: Twilio SMS (more reliable, requires account)
# Sign up at https://www.twilio.com/ and get these values:
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token  
# TWILIO_FROM_NUMBER=+15551234567

# Note: If Twilio variables are present, they will be used instead of email-to-SMS