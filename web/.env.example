# Hometown Handyman - Environment Variables

# Jobber API Configuration
JOBBER_CLIENT_ID=your_jobber_client_id
JOBBER_CLIENT_SECRET=your_jobber_client_secret
JOBBER_REDIRECT_URI=https://yourdomain.com/api/jobber/oauth/callback
JOBBER_API_VERSION=2023-11-15
JOBBER_ACCESS_TOKEN=your_access_token

# Email Service Configuration (for form fallback)
# Get API key from: https://resend.com/api-keys
EMAIL_API_KEY=re_your_resend_api_key_here
EMAIL_SERVICE=resend
FROM_EMAIL=noreply@yourdomain.com
ESTIMATES_EMAIL=estimates@yourdomain.com
REPLY_TO_EMAIL=estimates@yourdomain.com

# Rate Limiting & Security
RATE_LIMIT_SECRET=your_rate_limit_secret

# Next.js Configuration
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=https://yourdomain.com

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_token

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id